{"nodes": [{"id": "extraction_spec_subagent_prompt", "label": "Extraction Subagent Prompt Template", "file_type": "document", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 1-70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extraction_spec_node_id_format", "label": "Node ID Format Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs use parent_dir + filename_stem + entity, normalized to [a-z0-9_], to match AST extractor output and avoid ghost-duplicate nodes when merging semantic and structural extraction."}, {"id": "extraction_spec_confidence_rubric", "label": "Edge Confidence Score Rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 47-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discrete confidence scores (0.95/0.85/0.75/0.65/0.55) prevent the bimodal collapse to 0.5/0.85+ seen in production when continuous ranges are used. EXTRACTED always 1.0, AMBIGUOUS 0.1-0.3."}, {"id": "extraction_spec_file_type_enum", "label": "File Type Enum Constraint", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "extraction_spec_cross_lang_calls_rule", "label": "Cross-Language Calls Prohibition", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "calls edges must stay within one language \u2014 a Python function cannot calls a JS/TS symbol \u2014 because cross-language call edges are phantom artifacts with no structural basis."}], "edges": [{"source": "extraction_spec_node_id_format", "target": "graphify_skill_md_step3b_semantic", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "line 61", "weight": 1.0}, {"source": "extraction_spec_confidence_rubric", "target": "extraction_spec_subagent_prompt", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": "lines 47-58", "weight": 1.0}], "hyperedges": []}